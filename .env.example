# Mode
# Set NODE_ENV in the shell or npm script (e.g. `npm run start:dev`); it picks which .env.<NODE_ENV>*
# files are loaded, so a value here only fills in when the shell leaves it unset.
NODE_ENV=

# Every value below is optional: when it is empty, the value of jsreport.config.json is used.

# Port (default 5488)
PORT=

# Database
# The jsreport templates are stored in this database.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

# Admin Login
# Same values as JSREPORT_USER and JSREPORT_PASS of the API
JSREPORT_USER=
JSREPORT_PASS=

# Signs the jsreport studio login cookie
COOKIE_SECRET=
